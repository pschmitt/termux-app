<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background of the dialogs that are not built by MaterialAlertDialogBuilder, namely the
  androidx.preference ones (ListPreference and friends): the same 28dp surface in the row colour.
  MaterialAlertDialogBuilder replaces it with its own MaterialShapeDrawable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_row" />
    <corners android:radius="@dimen/ui_dialog_radius" />
</shape>
