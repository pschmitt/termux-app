<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/adb_shell_client_title">

    <PreferenceCategory
        app:key="adb_shell_client"
        app:title="@string/adb_shell_client_title">

        <Preference
            app:icon="@drawable/ui_ic_person"
            app:key="adb_shell_client_name"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/adb_shell_client_name_title" />

        <Preference
            app:icon="@drawable/ui_ic_lock"
            app:key="adb_shell_client_fingerprint"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/adb_shell_client_fingerprint_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="adb_shell_client_actions"
        app:title="@string/adb_shell_revoke_title">

        <Preference
            app:icon="@drawable/ui_ic_delete"
            app:key="adb_shell_client_revoke"
            app:persistent="false"
            app:summary="@string/adb_shell_revoke_summary"
            app:title="@string/adb_shell_revoke_title" />

    </PreferenceCategory>

</PreferenceScreen>
