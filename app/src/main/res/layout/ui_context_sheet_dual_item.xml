<?xml version="1.0" encoding="utf-8"?>
<!-- A label with two independent icon buttons (for example, Autofill username and password). The row itself
     is not clickable, so the label is never an ambiguous action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ui_touch_target"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/context_dual_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="center" />

    <TextView
        android:id="@+id/context_dual_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textAppearance="@style/TextAppearance.TermuxPP.SheetItem" />

    <ImageButton
        android:id="@+id/context_dual_first"
        android:layout_width="@dimen/ui_touch_target"
        android:layout_height="@dimen/ui_touch_target"
        android:background="@drawable/ui_icon_button_bg"
        android:scaleType="center" />

    <ImageButton
        android:id="@+id/context_dual_second"
        android:layout_width="@dimen/ui_touch_target"
        android:layout_height="@dimen/ui_touch_target"
        android:background="@drawable/ui_icon_button_bg"
        android:scaleType="center" />
</LinearLayout>
