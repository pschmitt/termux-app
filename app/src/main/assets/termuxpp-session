import argparse
import json
from pathlib import Path
import socket
import sys


def main():
    if sys.argv[1:2] == ["__complete"]:
        if sys.argv[2:] not in (["ids"], ["positions"]):
            return
        try:
            reply = exchange(["list"], timeout=0.25)
            key = {"ids": "id", "positions": "position"}[sys.argv[2]]
            for session in reply.get("result", []):
                print(session[key])
        except (OSError, ValueError, KeyError):
            pass
        return
    parser = argparse.ArgumentParser(description="Manage TermuxPP terminal sessions.")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="list sessions and their IDs").add_argument(
        "--json", action="store_true", help="output JSON"
    )
    actions = {
        "close": "hang up a shell or dismiss an exited tab",
        "focus": "switch to a session",
        "kill": "force-kill a session shell",
        "move": "move a session to a one-based position",
        "rename": "change the session name",
    }
    for action, help_text in actions.items():
        command = commands.add_parser(action, help=help_text)
        command.add_argument("id")
        if action == "move":
            command.add_argument("position", type=int)
        if action == "rename":
            command.add_argument("name")
    commands.add_parser("completions", help="print completion source").add_argument(
        "shell", choices=("bash", "fish", "zsh")
    )
    commands.add_parser("reload-settings", help="reload app properties and styling")
    argv = sys.argv[1:]
    if Path(sys.argv[0]).name == "termuxpp-reload-settings":
        argv = ["reload-settings", *argv]
    args = parser.parse_args(argv)
    if args.command == "completions":
        directory = Path(__file__).resolve().parent.parent / "share"
        names = {
            "bash": "bash-completion/completions/termuxpp-session",
            "fish": "fish/vendor_completions.d/termuxpp-session.fish",
            "zsh": "zsh/site-functions/_termuxpp-session",
        }
        print((directory / names[args.shell]).read_text(), end="")
        return

    request = [args.command]
    if args.command not in ("list", "reload-settings"):
        request.append(args.id)
    if args.command == "rename":
        request.append(args.name)
    if args.command == "move":
        request.append(args.position)
    try:
        reply = exchange(request)
        if "error" in reply:
            sys.exit(f"{parser.prog}: {reply['error']}")
    except ConnectionError as error:
        sys.exit(f"{parser.prog}: cannot reach TermuxPP; open the app first ({error})")
    except (OSError, ValueError) as error:
        sys.exit(f"{parser.prog}: {error}")

    if args.command == "list":
        sessions = reply["result"]
        if args.json:
            print(json.dumps(sessions))
        else:
            print("  POS  ID                                    STATE    NAME / TITLE")
            for session in sessions:
                current = "*" if session["current"] else " "
                state = "running" if session["running"] else "exited"
                label = session["name"] or session["title"]
                label = "".join(char if char.isprintable() else "?" for char in label)
                print(f"{current} {session['position']:>3}  {session['id']}  {state:<7}  {label}")


def exchange(request, timeout=5):
    payload = json.dumps(request, ensure_ascii=False).encode() + b"\n"
    if len(payload) > 4096:
        raise ValueError("session command is too long")
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(timeout)
        try:
            client.connect("\0dev.pschmitt.termux.sessions")
        except OSError as error:
            raise ConnectionError(error) from error
        client.sendall(payload)
        with client.makefile("rb") as response:
            return json.loads(response.readline(1024 * 1024))


if __name__ == "__main__":
    main()
