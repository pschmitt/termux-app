#compdef termuxpp-session

local context state state_descr line
typeset -A opt_args
_arguments -C '1:session command:->action' '2:session ID or option:->target' '3:position or name:->value'
case $state in
  action)
    local -a actions
    actions=(
      'list:List terminal sessions'
      'close:Hang up or dismiss a session'
      'focus:Switch to a session'
      'kill:Force-stop a session shell'
      'move:Reorder a session'
      'rename:Change the session name'
      'completions:Print completion source'
      '--help:Show help'
    )
    _describe 'session command' actions
    ;;
  target)
    case $words[2] in
      list) compadd - --json --help ;;
      completions) compadd - bash fish zsh ;;
      close|focus|kill|move|rename)
        local -a ids
        ids=( "${(@f)$(termuxpp-session __complete ids)}" )
        (( ${#ids} )) && compadd -a ids
        ;;
    esac
    ;;
  value)
    if [[ $words[2] == move ]]
    then
      local -a positions
      positions=( "${(@f)$(termuxpp-session __complete positions)}" )
      (( ${#positions} )) && compadd -a positions
    fi
    ;;
esac
