_termuxpp_session() {
  local current=${COMP_WORDS[COMP_CWORD]} action=${COMP_WORDS[1]-} candidate
  COMPREPLY=()
  if (( COMP_CWORD == 1 ))
  then
    mapfile -t COMPREPLY < <(compgen -W 'list close focus kill move rename reload-settings completions --help' -- "$current")
  elif (( COMP_CWORD == 2 )) && [[ $action == list ]]
  then
    mapfile -t COMPREPLY < <(compgen -W '--json --help' -- "$current")
  elif (( COMP_CWORD == 2 )) && [[ $action == completions ]]
  then
    mapfile -t COMPREPLY < <(compgen -W 'bash fish zsh' -- "$current")
  elif (( COMP_CWORD == 2 )) && [[ $action =~ ^(close|focus|kill|move|rename)$ ]]
  then
    while IFS= read -r candidate
    do
      [[ $candidate == "$current"* ]] && COMPREPLY+=("$candidate")
    done < <(termuxpp-session __complete ids)
  elif (( COMP_CWORD == 3 )) && [[ $action == move ]]
  then
    while IFS= read -r candidate
    do
      [[ $candidate == "$current"* ]] && COMPREPLY+=("$candidate")
    done < <(termuxpp-session __complete positions)
  fi
}
complete -F _termuxpp_session termuxpp-session
